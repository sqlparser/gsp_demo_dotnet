<Project>
  <!--
    Repo-wide MSBuild defaults. Every .csproj here inherits this file.

    These demos consume the published gudusoft.gsqlparser package from
    nuget.org, so this repo builds on its own: clone it and `dotnet run`, with
    no checkout of the library sources.

    GspVersion is the single place to bump the library. Every project
    references it as Version="$(GspVersion)".

    GOTCHA if you add a multi-targeting project: the singular TargetFramework
    below wins over a plural TargetFrameworks while it is non-empty, so a
    project that wants several TFMs must also reset the singular one to empty.
    See src/demos/dlineageCommon/demos.dlineageCommon.csproj.
  -->
  <PropertyGroup>
    <GspVersion>4.1.0.7</GspVersion>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>

    <!-- Assembly metadata. The SDK generates the [assembly: ...] attributes from
         these properties, so there are no hand-written AssemblyInfo.cs files.
         Version drives AssemblyVersion, FileVersion and InformationalVersion at
         once; demo binaries deliberately carry the parser version they were
         built against, so a stray dll can be traced back to a GSP release. -->
    <Copyright>Copyright © 2016-2026 Gudu Software Limited</Copyright>
    <Company>Gudu Software Limited</Company>
    <Product>General SQL Parser .NET Demos</Product>
    <Version>$(GspVersion)</Version>

    <!-- The demos are ported from Java and trip a lot of stylistic analysers
         (lower-case type names, obsolete-member use). They are sample code, not
         a product surface; keep the build readable. -->
    <NoWarn>$(NoWarn);CS8981;CS0618;CA2022;CS9266;CS9258</NoWarn>
  </PropertyGroup>

  <!-- Carried over from the deleted AssemblyInfo.cs files. The SDK does not
       emit this one, and without it every public type is COM-visible. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
