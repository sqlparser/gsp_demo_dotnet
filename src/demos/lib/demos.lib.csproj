<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Reusable analysers built on the parser: TGetTableColumn, xmlVisitor,
         columnInClause. Only net10.0 demos and the test projects consume these,
         so unlike demos.util there is no netstandard2.0 target to maintain. -->
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>gudusoft.gsqlparser.demos.lib</RootNamespace>
    <AssemblyName>demos.lib</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="gudusoft.gsqlparser" Version="$(GspVersion)" />
  </ItemGroup>
</Project>
