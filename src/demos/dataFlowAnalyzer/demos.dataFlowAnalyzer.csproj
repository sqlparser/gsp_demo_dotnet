<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>dataFlowAnalyzer</RootNamespace>
    <AssemblyName>dataFlowAnalyzer</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="gudusoft.gsqlparser" Version="$(GspVersion)" />
    <ProjectReference Include="..\util\demos.util.csproj" />
    <!-- dataFlowAnalyzer uses types from gudusoft.gsqlparser.demos.dlineage.util
         which live in dlineageCommon. -->
    <ProjectReference Include="..\dlineageCommon\demos.dlineageCommon.csproj" />
  </ItemGroup>

</Project>
