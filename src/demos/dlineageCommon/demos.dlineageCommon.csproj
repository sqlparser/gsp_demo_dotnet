<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Library used by the dlineage / dlineageRelation demos. Per repo rule-of-thumb, libraries multi-target. -->
    <!-- Clearing the singular TargetFramework inherited from Directory.Build.props
         is required for TargetFrameworks to take effect at all; see the longer
         note in Directory.Build.props. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>demos.dlineageCommon</RootNamespace>
    <AssemblyName>demos.dlineageCommon</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="gudusoft.gsqlparser" Version="$(GspVersion)" />
    <ProjectReference Include="..\util\demos.util.csproj" />
  </ItemGroup>

</Project>
