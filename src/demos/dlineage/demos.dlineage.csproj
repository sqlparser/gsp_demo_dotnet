<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>dlineage</RootNamespace>
    <AssemblyName>dlineage</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="gudusoft.gsqlparser" Version="$(GspVersion)" />
    <ProjectReference Include="..\dlineageCommon\demos.dlineageCommon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\util\common.cs" Link="common.cs" />
  </ItemGroup>

  <!-- Exclude stale duplicates that were refactored into dlineageCommon/ but
       whose historical copies were never deleted from this directory.
       DlineageRelation.cs lives in ..\dlineageRelation\ (its own demo).
       StringHelperClass.cs is a leftover helper not referenced by Dlineage.cs. -->
  <ItemGroup>
    <Compile Remove="columnImpact\**\*.cs" />
    <Compile Remove="metadata\**\*.cs" />
    <Compile Remove="model\**\*.cs" />
    <Compile Remove="util\**\*.cs" />
    <Compile Remove="DlineageRelation.cs" />
    <Compile Remove="StringHelperClass.cs" />
  </ItemGroup>
</Project>
